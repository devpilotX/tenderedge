# ───────────────────────────── TenderEdge environment ─────────────────────────────
# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (primary datastore)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=tenderedge
# Separate database used by the automated test suite (created/dropped by db:setup).
PGDATABASE_TEST=tenderedge_test
# Max pool connections
PG_POOL_MAX=10
# Non-superuser role used for tenant-scoped queries so Row-Level Security is enforced
# (superusers bypass RLS). Created automatically by the migrations. On localhost with
# trust auth no password is needed. In production, prefer a NOSUPERUSER role.
PGAPPUSER=tenderedge_app
PGAPPPASSWORD=

# Job queue / pub-sub driver: "redis" (production, BullMQ+ioredis) or "memory" (dev/test, no Redis required)
QUEUE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# Object storage driver for Business_Documents: "local" (encrypted files on disk) or "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# 32-byte key, base64-encoded. Used for AES-256-GCM document encryption at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=
# S3 settings (only when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=

# Auth
# 32+ char secret for signing session tokens.
SESSION_SECRET=change-me-in-production-please-use-a-long-random-string
# Inactivity timeout in minutes (spec: 30).
SESSION_INACTIVITY_MINUTES=30

# Notification providers (integration drivers; "console" logs instead of sending in dev)
EMAIL_DRIVER=console
SMS_DRIVER=console
EMAIL_FROM=alerts@tenderedge.example

# Billing provider driver: "mock" (dev/test) or "stripe"
BILLING_DRIVER=mock
STRIPE_SECRET_KEY=

# Tender Radar
RADAR_POLL_INTERVAL_MINUTES=15
RADAR_MIN_RATE_LIMIT_RPM=6

# Backups
BACKUP_INTERVAL_HOURS=24
BACKUP_DIR=./backups
